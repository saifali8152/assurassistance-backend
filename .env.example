# AssurAssistance Backend – copy to .env and fill in values
# For Hostinger VPS: DB_HOST=localhost, DB_* from the database you created

PORT=3000
NODE_ENV=production

# Database (use localhost when DB is on same VPS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=assurassistance
DB_USER=assurapp
DB_PASSWORD=your_db_password

# JWT – use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="AssurAssistance <your-email@gmail.com>"

# URLs
BASE_URL=https://your-backend-domain.com
FRONTEND_URL=https://assurassistancepro.org
# Public API origin (no /api) — used for absolute URLs to /uploads (e.g. certificate partner logos)
PUBLIC_API_URL=https://your-backend-domain.com

# Certificate contact lines (general inquiries + WhatsApp + Central Africa on every certificate)
CERTIFICATE_GENERAL_PHONE=+225 27 22 22 82 60
CERTIFICATE_WHATSAPP_PHONE=+225 07 18 92 31 94
CERTIFICATE_CENTRAL_AFRICA_PHONE=+(242)061603452
# CERTIFICATE_EMERGENCY_PHONE=+91 62916 62954
# CERTIFICATE_WEBSITE_URL=https://www.assurassistance.org

# Optional
ADMIN_EMAIL=admin@example.com
BCRYPT_ROUNDS=12

# Per-IP global rate limit on /api (express-rate-limit). 600 req / 15 min by default.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# Per-API-key default requests-per-minute (per-key override available on each key row).
API_KEY_DEFAULT_RPM=120

MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# Comma-separated list of additional CORS origins. The hardcoded production origins are
# always allowed; this is for partner / staging / preview domains.
# CORS_ORIGINS=https://partner.example.com,https://staging.assurassistancepro.org

# ---------------------------------------------------------------------------
# Settings encryption (required by the WhatsApp module)
#
# The superadmin manages WhatsApp credentials in the admin UI, and they are
# stored AES-256-GCM encrypted in the `app_settings` table. This is the master
# key for that encryption and is the ONE secret that must stay in the
# environment. Generate it once per environment and never change it without
# re-entering the credentials:
#
#   openssl rand -hex 32
#
SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Business API — FIRST-BOOT FALLBACK ONLY
#
# Leave these empty in normal operation. They are read only when the matching
# row in `app_settings` is still empty, so an environment can be brought up
# before anyone logs into the admin UI. Once the superadmin saves the settings,
# the database values win and these are ignored.
#
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Logging and error monitoring
#
# Both are optional. With pino absent the logger falls back to console, and with
# no SENTRY_DSN the monitoring calls are no-ops — so an environment that has not
# run `npm i` behaves exactly as it did before.
#
#   npm i pino @sentry/node
#
LOG_LEVEL=info
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# ---- Milestone 3 ----------------------------------------------------------
# Where failures are reported. Unset means nothing tells anyone when something breaks.
ALERT_EMAIL=
# Where the daily transaction summary goes. Falls back to ALERT_EMAIL.
SUMMARY_EMAIL=
# How long before the same problem is reported again (default 15).
ALERT_WINDOW_MINUTES=
# Hard cap on alert emails per hour (default 20).
ALERT_MAX_PER_HOUR=
# 1 registers the mock payment provider. Never set this in production.
PAYMENT_ALLOW_MOCK=
