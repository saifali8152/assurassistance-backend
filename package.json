{
  "name": "assurassistance-backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "migrate:baseline": "node scripts/migrate.js --baseline",
    "prune:messages": "node scripts/pruneMessages.js",
    "prune:messages:dry": "node scripts/pruneMessages.js --dry-run",
    "seed:admin": "node scripts/seedAdmin.js",
    "reassign:it-voyages": "node scripts/reassignItVoyagesToEsther.js",
    "sweep:payments": "node scripts/sweepPayments.js",
    "sweep:payments:dry": "node scripts/sweepPayments.js --dry-run",
    "encrypt:passports:dry": "node scripts/encryptPassports.js --dry-run",
    "encrypt:passports": "node scripts/encryptPassports.js",
    "encrypt:passports:clear": "node scripts/encryptPassports.js --clear",
    "summary:daily": "node scripts/dailySummary.js",
    "summary:daily:dry": "node scripts/dailySummary.js --dry-run",
    "poll:payments": "node scripts/pollPayments.js",
    "poll:payments:dry": "node scripts/pollPayments.js --dry-run"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "fast-csv": "^5.0.5",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.5",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.17.2",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
